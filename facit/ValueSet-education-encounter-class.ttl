       fhir:ValueSet.compose.include.concept [
         fhir:index 0 ;
         fhir:ValueSet.compose.include.concept.code [ fhir:value "AMB" ] ;
         fhir:ValueSet.compose.include.concept.display [ fhir:value "ambulatory" ]
       ], [
         fhir:index 1 ;
